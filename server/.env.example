PORT=5000
CLIENT_URL=http://localhost:5173

# Cách 1: một chuỗi kết nối (khuyên dùng với Neon)
DATABASE_URL=
DATABASE_SSL=false

# Cách 2: khai báo riêng (dùng khi để trống DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=travel_ai_booking
PGUSER=travel_app
PGPASSWORD=replace_me

# Chuỗi ngẫu nhiên, ít nhất 32 ký tự
SESSION_SECRET=

# Tùy chọn: để trống thì vẫn có gợi ý từ database, chỉ chưa có chat AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
